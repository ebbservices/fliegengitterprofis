# Medusa Backend Environment Variables
# Kopiere diese Datei zu .env und fülle die Werte aus

# ==============================================
# DEVELOPMENT ENVIRONMENT
# ==============================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://medusa_user:YOUR_PASSWORD_HERE@10.0.0.6:5432/diefliegengitterprofis_dev

# Redis
REDIS_URL=redis://redis.default.svc.cluster.local:6379/0

# Medusa Backend
NODE_ENV=development
PORT=9000
STORE_CORS=http://localhost:3000,https://dev.diefliegengitterprofis.mobatix.de
ADMIN_CORS=http://localhost:7001,http://localhost:9000

# JWT Secret (generiere einen sicheren Wert)
JWT_SECRET=your-super-secret-jwt-token-change-this

# Cookie Secret (generiere einen sicheren Wert)
COOKIE_SECRET=your-super-secret-cookie-token-change-this

# ==============================================
# PRODUCTION ENVIRONMENT (auskommentiert)
# ==============================================

# DATABASE_URL=postgresql://medusa_user:YOUR_PASSWORD_HERE@10.0.0.6:5432/diefliegengitterprofis_prod
# REDIS_URL=redis://redis.default.svc.cluster.local:6379/1
# NODE_ENV=production
# PORT=9000
# STORE_CORS=https://www.diefliegengitterprofis.de
# ADMIN_CORS=https://admin.diefliegengitterprofis.de

# ==============================================
# OPTIONAL: Email (für Bestellbestätigungen)
# ==============================================

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=noreply@diefliegengitterprofis.de

# ==============================================
# OPTIONAL: File Storage (S3-kompatibel)
# ==============================================

# MINIO_ENDPOINT=minio.example.com
# MINIO_BUCKET=medusa-uploads
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key

# ==============================================
# HINWEISE
# ==============================================

# 1. Ändere ALLE Secrets und Passwörter!
# 2. Verwende für Produktion andere Werte als für Development
# 3. Speichere diese Datei NIEMALS in Git (ist in .gitignore)
# 4. Für Kubernetes: Verwende Secrets statt .env-Dateien
