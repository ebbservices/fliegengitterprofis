# Medusa Admin
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# CORS Settings
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,http://localhost:3000

# Database
# Format: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# Redis
# Format: redis://:<password>@<host>:6379/<db>
REDIS_URL=

# Secrets (REQUIRED - generate with: openssl rand -base64 64)
JWT_SECRET=
COOKIE_SECRET=

# Email (SMTP / Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@mobatix.de
SMTP_FROM_NAME=Mobatix GmbH

# Payment - Stripe (leer lassen bis Kunde Keys hat)
# PayPal kann als Zahlungsmethode in Stripe aktiviert werden
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
